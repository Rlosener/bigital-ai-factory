# Copy to deploy/.env.bigital. Never commit this runtime file.
# Generate independent secrets with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OAUTH_ENCRYPTION_SECRET=__CHANGE_ME__
INBOX_WEBHOOK_SECRET=__CHANGE_ME__
API_AUTH_TOKEN=__CHANGE_ME__
# Existing host directory mounted at /workspace inside the container.
BIGITAL_PROJECTS_DIR=/absolute/path/to/repositories
# Provider API keys are entered in Settings and encrypted in SQLite.
# Log in to tool-enabled CLI providers inside the container before software execution.
